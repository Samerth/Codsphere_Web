# CodSphere Marketing Site - Environment Variables
# ================================================
# Copy this file to .env.local and fill in your values.

# =============================================================================
# ANALYTICS (Required for production tracking)
# =============================================================================
# Google Analytics 4 Measurement ID
# Get this from: Google Analytics > Admin > Property > Data Streams > Web
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# =============================================================================
# EMAIL - SENDGRID (Demo-site routes only: /api/quote, /api/review)
# =============================================================================
# Marketing lead capture now goes through CodCRM embeds, not these routes.
# Keep SendGrid for the demo sites (/movers, /aqua-fix, /trade-demo).
# Get this from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Verified sender email for SendGrid
# Must be a verified sender identity in SendGrid
SENDGRID_VERIFIED_SENDER=

# =============================================================================
# COMPANY CONTACT (Required for demo-site form submissions)
# =============================================================================
# Email address where demo-site form submissions are delivered
COMPANY_EMAIL=
