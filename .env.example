# CodSphere Marketing Site - Environment Variables
# ================================================
# Copy this file to .env.local and fill in your values.

# =============================================================================
# ANALYTICS (Required for production tracking)
# =============================================================================
# Google Analytics 4 Measurement ID
# Get this from: Google Analytics > Admin > Property > Data Streams > Web
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# =============================================================================
# EMAIL - RESEND (Primary email provider for contact forms)
# =============================================================================
# Resend API key - used by /api/contact and /api/contact/lead
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender email for Resend
# Must be a verified domain in Resend dashboard
RESEND_FROM_EMAIL=

# =============================================================================
# EMAIL - SENDGRID (Legacy routes - subscribe, quote, review, free-trial)
# =============================================================================
# SendGrid API key
# Get this from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Verified sender email for SendGrid
# Must be a verified sender identity in SendGrid
SENDGRID_VERIFIED_SENDER=

# =============================================================================
# COMPANY CONTACT (Required for form submissions)
# =============================================================================
# Email address where form submissions are delivered
COMPANY_EMAIL=

# =============================================================================
# CRM INTEGRATION (Optional - for lead capture to CodCRM)
# =============================================================================
# CodCRM API endpoint - set if using CodCRM for lead management
CODCRM_API_URL=

# CodCRM API key for authentication
CODCRM_API_KEY=
